# Contoh konfigurasi lingkungan untuk PeopleBot
# Salin file ini menjadi `.env` dan isi sesuai kebutuhan.

# Konfigurasi Serial Port
SERIAL_PORT=COM5
SERIAL_BAUDRATE=9600

# Konfigurasi RabbitMQ
# Hostname atau IP server RabbitMQ
RABBITMQ_HOST=localhost
# Nama queue yang digunakan oleh skrip kontrol
RABBITMQ_QUEUE=control
RABBITMQ_QUEUE_SENSOR=sensor
RABBITMQ_QUEUE_TERMINAL=terminal
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Virtual host (gunakan "/" untuk default)
RABBITMQ_VHOST=/

# Sensor subscription backend
# mqtt = subscribe sensor via MQTT topic
# amqp = subscribe sensor via RabbitMQ queue
SENSOR_SUBSCRIBE_TRANSPORT=mqtt

# Konfigurasi MQTT khusus sensor
SENSOR_MQTT_HOST=localhost
SENSOR_MQTT_PORT=1883
SENSOR_MQTT_USER=guest
SENSOR_MQTT_PASSWORD=guest
SENSOR_MQTT_TOPIC=sensor
SENSOR_MQTT_CLIENT_ID=remote-control-sensor-subscriber

# Sensor input mode
# true = gunakan data simulasi, false = baca data nyata dari P3-DX via serial
SENSOR_SIMULATION=true

# Lokasi default peta (latitude,longitude)
LOCATION=-6.95360761453292,107.6965409137443
